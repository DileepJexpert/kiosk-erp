# =============================================================================
# Kiosk ERP — Production Environment Variables Template
# =============================================================================
# Copy this file to .env and configure all required secrets for your environment.

# -----------------------------------------------------------------------------
# Core Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# PostgreSQL Connection String (Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL=postgresql://kiosk_user:kiosk_secure_password@localhost:5432/kiosk_erp?schema=public

# -----------------------------------------------------------------------------
# NextAuth / Authentication
# -----------------------------------------------------------------------------
# Full canonical URL of your deployment (e.g., https://erp.yourkiosks.com)
NEXTAUTH_URL=http://localhost:3000

# Generate a strong 32+ character random secret (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET=generate-a-strong-32-byte-secret-key-here

# Set to false in production! If set to true in dev/staging, any 6-digit OTP will authenticate
MOCK_OTP_ENABLED=false

# -----------------------------------------------------------------------------
# MSG91 SMS Service (Production OTP Provider)
# -----------------------------------------------------------------------------
# Sign up at msg91.com to obtain auth key and create OTP DLT template
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# -----------------------------------------------------------------------------
# Claude / Anthropic AI (Smart Purchase Entry, Bill Scanning, Voice/Text Parsing)
# -----------------------------------------------------------------------------
# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_TEXT_MODEL=claude-haiku-4-5-20251001
CLAUDE_VISION_MODEL=claude-sonnet-4-6

# -----------------------------------------------------------------------------
# Razorpay (UPI QR Generation & Payment Reconciliation)
# -----------------------------------------------------------------------------
# Obtain from dashboard.razorpay.com -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# OpenWeatherMap (Weather Forecasting & Demand Intelligence)
# -----------------------------------------------------------------------------
# Free tier API key from openweathermap.org
OPENWEATHERMAP_API_KEY=

# -----------------------------------------------------------------------------
# Cloudflare R2 / S3-compatible Object Storage (Bill photos & compliance documents)
# -----------------------------------------------------------------------------
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=kiosk-erp-production-files
